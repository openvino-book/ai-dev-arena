{
  "name": "realtime-chat-tests",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --verbose --forceExit --runInBand",
    "test:ci": "jest --verbose --forceExit --ci"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "clearMocks": true,
    "preset": "ts-jest",
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "tsconfig": {
          "target": "ES2022",
          "module": "commonjs",
          "strict": true,
          "esModuleInterop": true,
          "skipLibCheck": true
        }
      }]
    },
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json", "node"]
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "uuid": "^11.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.0",
    "typescript": "^5.7.0"
  }
}
